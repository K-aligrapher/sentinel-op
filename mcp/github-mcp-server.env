# github-mcp-server — run as:
#   docker run -d --name github-mcp \
#     -e GITHUB_PERSONAL_ACCESS_TOKEN=$GITHUB_TOKEN \
#     -p 8002:8080 ghcr.io/github/github-mcp-server:latest
# The token is injected from the host environment — never commit a real value here.
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_MCP_PORT=8080
GITHUB_TOOLSETS=repos,pull_requests,issues
