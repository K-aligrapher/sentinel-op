# ─── LLM ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ─── Kubernetes ────────────────────────────────────────────────────────────
KUBECONFIG=~/.kube/config
K8S_MCP_URL=http://localhost:8000

# ─── Prometheus ────────────────────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090

# ─── GitHub ────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=PRATHVI9607/sentinel
GITHUB_API_URL=https://api.github.com
GITHUB_DEFAULT_BRANCH=main

# ─── Daytona sandbox ───────────────────────────────────────────────────────
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# ─── Sandbox safety ────────────────────────────────────────────────────────
MAX_SANDBOX_EXEC_SECONDS=120
ALLOWED_SANDBOX_COMMANDS=kubectl,curl,grep,cat,echo,python3

# ─── TrueForge ─────────────────────────────────────────────────────────────
TRUEFORGE_URL=http://localhost:8790

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs

# ─── Alerts / approval ─────────────────────────────────────────────────────
ALERT_WEBHOOK_PORT=9093
APPROVAL_TIMEOUT_MINUTES=15
SENTINEL_APPROVAL_MODE=callback        # callback | file | auto
SESSION_DB_PATH=./logs/incidents.db
SLACK_WEBHOOK_URL=

# ─── Local dev toggles (never set in production) ───────────────────────────
# SENTINEL_SKIP_ENV_CHECK=1
# SENTINEL_AUTO_DECISION=APPROVED
